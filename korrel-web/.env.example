# Copy this file to .env.local for local development.
# Set the same values in Cloudflare Pages → Settings → Environment Variables
# for production builds.
#
# All variables are prefixed with NEXT_PUBLIC_ because they're used by both
# server components and client-side Sanity helpers (image URL builder, etc.)
# — none of them are secret.

# Your Sanity project ID (see korrel-studio/sanity.config.ts or sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=18qry6x0

# The dataset to read from (usually "production")
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version, in YYYY-MM-DD format
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
